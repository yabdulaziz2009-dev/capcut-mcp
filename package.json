{
  "name": "capcut-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that assembles CapCut projects and generates the assets CapCut cannot make itself. Independent, unofficial, not affiliated with ByteDance.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabdulaziz2009-dev/capcut-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "capcut-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "capcut-cli": "0.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "5.6.3"
  },
  "license": "MIT"
}
